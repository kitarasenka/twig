{
  "name": "twig",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "An independent desktop Git workspace with a visual commit graph",
  "author": "nodex contributors",
  "license": "UNLICENSED",
  "nodexInstall": false,
  "main": "main/index.js",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "test": "npm run lint && node scripts/checks/foundation.mjs && node scripts/checks/status-parser.mjs && node scripts/checks/git-exec.mjs && node scripts/checks/history.mjs && node scripts/checks/refs.mjs && node scripts/checks/commit.mjs && node scripts/checks/graph.mjs",
    "test:smoke": "npm run build && node scripts/smoke.mjs && node scripts/history-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.0",
    "@fontsource/fira-sans": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "41.7.1",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.56.0",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "app.nodex.twig",
    "productName": "🌱Twig",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  }
}
