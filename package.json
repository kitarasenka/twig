{
  "name": "git-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An independent desktop Git workspace with a visual commit graph",
  "author": "nodex contributors",
  "license": "UNLICENSED",
  "nodexInstall": false,
  "main": "main/index.js",
  "engines": { "node": ">=20.19.0 <21" },
