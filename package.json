    "electron": "41.7.1",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.56.0",
    "vite": "8.2.2"
